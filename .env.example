# Neo4j Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=grasp
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-password-here

# Connection type: "driver" (default, uses neo4j-driver npm package)
# or "cypher-shell" (uses the cypher-shell CLI — must be installed separately).
# Use "cypher-shell" if you experience transient DNS failures with the driver.
NEO4J_CONNECTION_TYPE=driver